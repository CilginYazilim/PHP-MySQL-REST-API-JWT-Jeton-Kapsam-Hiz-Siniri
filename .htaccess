# =====================================================================
#  KÖK DİZİN KURALLARI
#  cilginyazilim.com – Sıfır Bağımlılık JWT REST API
# ---------------------------------------------------------------------
#  Bu dosya alt klasörlere de MİRAS KALIR (ölçüldü) — buradaki güvenlik
#  başlıkları assets/ ve system/ yanıtlarında da geçerlidir.
# =====================================================================

# ---------------------------------------------------------------------
#  1) KLASÖR İÇERİĞİ LİSTELENMESİN
# ---------------------------------------------------------------------
#  index dosyası olmayan bir klasöre girildiğinde Apache varsayılan
#  olarak dosya listesini basar. Saldırganın "burada ne var?" sorusunu
#  bedavaya cevaplamanın gereği yok.
Options -Indexes

# ---------------------------------------------------------------------
#  2) ÇALIŞTIRILMAYAN DOSYALAR İNDİRİLEMESİN
# ---------------------------------------------------------------------
#  ÖLÇÜLEN SORUN: /cy_api_jwt.sql adresi HTTP 200 ile veritabanı kurulum
#  dosyasının tamamını indiriyordu — tablo yapısı ve API anahtarı kimlikleri ve secret hash'leri dahil.
#  Bu depoda veri zaten örnek/uydurmadır ama desen tehlikelidir: aynı
#  düzenle canlıya alınan bir projede o dosya gerçek müşteri verisi
#  taşır. Şema ve örnek veri KURULUM malzemesidir; web sunucusunun
#  onları servis etmesi için hiçbir sebep yoktur.
<FilesMatch "\.(sql|md|json|lock|log|ini|bak|dist|example)$">
    Require all denied
</FilesMatch>

# Nokta ile başlayan dosyalar (.htaccess, .gitignore, .env …).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------
#  README İSTİSNASI
# ---------------------------------------------------------------------
#  Yukarıdaki kural bütün .md dosyalarını kapatır. Ama kütüphane
#  vitrini (cilginyazilim.com/kutuphane) bu projenin README'sini
#  İÇERİK OLARAK okur; kapalı kalırsa örneğin anlatımı boş görünür.
#  Bu yüzden yalnızca README.md ve README.<dil>.md geri açılır —
#  CHANGELOG.md dahil diğer bütün .md dosyaları kapalı kalır.
# ---------------------------------------------------------------------
<FilesMatch "^README(\.[a-z]{2})?\.md$">
    Require all granted
</FilesMatch>

# Klasör kökünde index.php çalışsın (Options -Indexes ile birlikte,
# dizinin listelenmesi yerine uygulamanın açılmasını sağlar).
DirectoryIndex index.php index.html

# ---------------------------------------------------------------------
#  3) GÜVENLİK BAŞLIKLARI
# ---------------------------------------------------------------------
<IfModule mod_headers.c>
    # Tarayıcı Content-Type'ı tahmin etmeye çalışmasın. api/index.php
    # zaten kendi JSON yanıtlarına bu başlığı ekliyor (bkz. api_json)
    # ama index.php ve assets/ altındaki dosyalarda hiç yoktu.
    Header always set X-Content-Type-Options "nosniff"

    # Sayfa başka bir sitenin çerçevesine gömülmesin. Bu projede önemi
    # somuttur: görünmez bir çerçeveye alınmış sayfada kullanıcıya
    # farkında olmadan konsoldaki bir "DELETE" düğmesi tıklatılabilir (clickjacking).
    Header always set X-Frame-Options "SAMEORIGIN"

    # Dış sitelere giderken tam URL yerine yalnızca alan adı gönderilsin.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Bu sayfanın ihtiyacı olmayan tarayıcı yetenekleri kapatılsın.
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
